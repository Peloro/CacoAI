# ═══ PROVEDOR DE IA ═══
LLM_PROVIDER=groq

# Groq (opcional - o bot funciona 100% sem)
# Obtenha sua chave em: https://console.groq.com/keys
GROQ_API_KEY=
# Modelos do plano gratuito (vazio = padrão). Cada um tem cota própria; se uma acabar, o app usa o outro.
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
# Raciocínio dos gpt-oss: low | medium | high (low gasta menos tokens)
GROQ_REASONING_EFFORT=low
# Tokens reservados para o raciocínio em cada chamada (aumente se `python run.py ia` acusar resposta cortada)
LLM_RESERVA_RACIOCINIO=384
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter (compatibilidade opcional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m2.5:free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=CacoAI

# Telegram Bot API (opcional)
# Crie o bot no @BotFather e cole o token abaixo
TELEGRAM_BOT_TOKEN=
TG_SEND_TYPING=true
TG_POLL_TIMEOUT=25

# Banco de dados
DATABASE_PATH=financeiro.db

# Servidor (em produção, Render injeta PORT automaticamente)
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# API REST de teste (mantenha desabilitada em uso real do Telegram)
API_TEST_ENABLED=false
API_TEST_TOKEN=

# Log local de todas as requisicoes/respostas do bot (para testes)
BOT_REQUEST_LOG_ENABLED=true
BOT_REQUEST_LOG_PATH=logs/bot_requests.log
