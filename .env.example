# ═══ PROVEDOR DE IA ═══
LLM_PROVIDER=groq

# Groq (opcional - o bot funciona 100% sem)
# Obtenha sua chave em: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter (compatibilidade opcional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m2.5:free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=CacoAI

# Meta WhatsApp Cloud API (GRÁTIS - 1000 conversas/mês)
# Configure em: https://developers.facebook.com → Seu App → WhatsApp → API Setup
WHATSAPP_TOKEN=seu_token_permanente_aqui
WHATSAPP_PHONE_ID=seu_phone_id_aqui
WHATSAPP_VERIFY_TOKEN=caco-verify-token-2026
WHATSAPP_APP_SECRET=seu_app_secret_aqui

# Telegram Bot API (opcional)
# Crie o bot no @BotFather e cole o token abaixo
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TG_DEDUP_TTL=300
TG_SEND_TYPING=true
TG_POLL_TIMEOUT=25

# Banco de dados
DATABASE_PATH=financeiro.db

# Servidor (em produção, Render injeta PORT automaticamente)
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# API REST de teste (mantenha desabilitada em uso real do Telegram/WhatsApp)
API_TEST_ENABLED=false
API_TEST_TOKEN=

# Log local de todas as requisicoes/respostas do bot (para testes)
BOT_REQUEST_LOG_ENABLED=true
BOT_REQUEST_LOG_PATH=logs/bot_requests.log
